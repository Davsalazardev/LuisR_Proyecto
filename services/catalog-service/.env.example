# catalog-service — copiar como .env en ec2-catalog (NUNCA subir el .env real)
CATALOG_SERVICE_PORT=8001
MONGO_URI=mongodb://catalog_admin:<CAMBIAR_PASSWORD_MONGO>@127.0.0.1:27017/tienda_catalogo?authSource=admin
MONGO_DB_NAME=tienda_catalogo
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=<CAMBIAR_PASSWORD_REDIS_CACHE>
CATALOG_CACHE_TTL_PRODUCT_SECONDS=300
CATALOG_CACHE_TTL_LIST_SECONDS=120
CATALOG_CACHE_TTL_REVIEWS_SECONDS=120
