# ==============================================================================
# Tienda Departamental AWS - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo como `.env` en cada servidor/entorno local:
#        cp .env.example .env
#   2. Sustituye todos los valores <CAMBIAR_...> por credenciales seguras.
#   3. NUNCA hagas commit del archivo `.env` ni de llaves `.pem`.
# ==============================================================================

# --- Entorno general ---
APP_ENV=development
LOG_LEVEL=info

# --- Servicio 1: Catálogo (MongoDB + Redis Caché) ---
CATALOG_SERVICE_PORT=8001
MONGO_INITDB_ROOT_USERNAME=catalog_admin
MONGO_INITDB_ROOT_PASSWORD=<CAMBIAR_PASSWORD_MONGO>
MONGO_DB_NAME=tienda_catalogo
MONGO_URI=mongodb://catalog_admin:<CAMBIAR_PASSWORD_MONGO>@10.0.2.10:27017/tienda_catalogo?authSource=admin

REDIS_CACHE_HOST=10.0.2.10
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=<CAMBIAR_PASSWORD_REDIS_CACHE>
CATALOG_CACHE_TTL_PRODUCT_SECONDS=300
CATALOG_CACHE_TTL_LIST_SECONDS=120

# --- Servicio 2: Carrito y Sesiones (Redis) ---
CART_SERVICE_PORT=8002
REDIS_CART_HOST=10.0.2.20
REDIS_CART_PORT=6379
REDIS_CART_PASSWORD=<CAMBIAR_PASSWORD_REDIS_CART>
CART_TTL_SECONDS=604800
SESSION_TTL_SECONDS=86400

# --- Servicio 3: Órdenes e Inventario (PostgreSQL) ---
ORDERS_SERVICE_PORT=8003
POSTGRES_HOST=10.0.2.30
POSTGRES_PORT=5432
POSTGRES_DB=tienda_ordenes
POSTGRES_USER=orders_admin
POSTGRES_PASSWORD=<CAMBIAR_PASSWORD_POSTGRES>
DATABASE_URL=postgresql://orders_admin:<CAMBIAR_PASSWORD_POSTGRES>@10.0.2.30:5432/tienda_ordenes

# --- Comunicación interna entre microservicios (solo vía API HTTP en red privada) ---
CATALOG_API_URL=http://10.0.2.10:8001
CART_API_URL=http://10.0.2.20:8002
ORDERS_API_URL=http://10.0.2.30:8003
SERVICE_HTTP_TIMEOUT_MS=3000

# --- Despliegue AWS (solo uso local con AWS CLI; no guardar claves AWS aquí) ---
AWS_REGION=us-east-1
AWS_KEY_PAIR_NAME=tienda-departamental-key
ADMIN_ALLOWED_CIDR=<TU_IP_PUBLICA>/32
